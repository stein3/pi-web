#!/usr/bin/env bash
# Fake pi for pi-web integration test: replays a scripted stream on RPC mode.
# Ignores --list-models? No — still serve it so /oc/config/providers works.
for a in "$@"; do [ "$a" = "--list-models" ] && { printf 'provider   model      context  max-out  thinking  images\ntestprov   fake-1     128K     4K       yes       no\n'; exit 0; }; done
exec node /workspace/pi-local/web/.testbin/fake-pi.mjs "$@"
